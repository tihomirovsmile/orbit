{
  "name": "orbit-social",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch apps/server/src/index.ts\" \"vite --config apps/web/vite.config.ts\"",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "start": "tsx apps/server/src/index.ts",
    "launch": "node scripts/launch.mjs --mode local",
    "launch:web": "node scripts/launch.mjs --mode lan",
    "launch:app": "node scripts/launch.mjs --mode app",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx apps/server/src/database/migrate.ts",
    "db:restore": "tsx scripts/restore.ts",
    "db:reset": "tsx scripts/reset-setup.ts",
    "format": "prettier --write apps packages tests scripts",
    "check": "npm run build && npm test",
    "build:server": "tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.10",
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.6.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.10.0",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  },
  "license": "MIT",
  "description": "Orbit — experimental social network. Final release; no further updates or support.",
  "repository": {
    "type": "git",
    "url": "https://github.com/tihomirovsmile/orbit.git"
  }
}
